# Copy to .env. Every value is optional; the demo runs with none of them.

# openFDA (free key: https://open.fda.gov/apis/authentication/). Without one, the public rate limit applies.
OPENFDA_API_KEY=

# ---- AI agents (see docs/AGENTS.md). Advisory only: rules run first, a gate checks the model, a pharmacist decides.
# Which provider the agents use at start-up: bedrock (default) | anthropic | openai-compatible | mock | none
#   mock = deterministic and offline, no key needed (good for a demo with no network). none = rules only.
# A judge can also pick the provider and model, and paste a key, on the AI Agents screen. A pasted key stays in server memory only.
LLM_PROVIDER=
# bedrock: Converse API through the default AWS credential chain (env keys, AWS_PROFILE, SSO, or an instance role)
AWS_REGION=us-east-1
AWS_PROFILE=
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5
# anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
# openai-compatible: OpenAI, Azure OpenAI, Ollama (http://localhost:11434/v1), LM Studio (http://localhost:1234/v1), vLLM
OPENAI_BASE_URL=
# the key is OPENAI_API_KEY (set in the voice section below; the same key serves both). Ollama and LM Studio need none.
OPENAI_MODEL=

# Server
API_PORT=4000
DATA_DIR=./data
# Seed the synthetic dataset on a fresh database and re-seed it when the seed version changes (1 = on, 0 = never seed)
SEED_SYNTHETIC=1
# Pretend today is this date (YYYY-MM-DD). Empty = the real date.
TODAY=

# Voicemail voice (text-to-speech only; nothing is dialled).
# auto tries ElevenLabs -> OpenAI -> Kokoro (when KOKORO_URL is set) -> best macOS voice -> the browser's voice. No voice cloning.
# kokoro = the open Kokoro-82M model on this machine (see scripts/voiceover/README.md for the local server).
VOICE_PROVIDER=auto
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_turbo_v2_5
OPENAI_API_KEY=
OPENAI_TTS_VOICE=coral
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Force a macOS voice, e.g. "Ava (Premium)" after downloading it in System Settings > Accessibility > Spoken Content
MAC_VOICE=
# Local Kokoro speech server (OpenAI-compatible /v1/audio/speech). Loopback only: any other host is refused at start-up.
KOKORO_URL=
# Male voices: am_michael (default), am_adam
KOKORO_VOICE=am_michael
KOKORO_SPEED=1

# ---- Security (see docs/SECURITY.md). Pilot controls, not a compliance claim.
# Where the data key for encrypting patient fields comes from: env | file | kms. Empty = env when DATA_KEY is set, else file.
KEY_PROVIDER=
# env provider: a base64 32-byte key (openssl rand -base64 32). Empty = the file provider makes DATA_DIR/.keys/data.key (mode 0600).
DATA_KEY=
# env provider: older keys, comma separated, so rows written before a rotation still open
DATA_KEY_PREVIOUS=
# env provider, rotation only: the key you are rotating to (pnpm --filter @chimera-rx/api keys:rotate)
NEW_DATA_KEY=
# Send the session cookie over HTTPS only (1 = on). Turn on whenever a TLS proxy sits in front of the API.
COOKIE_SECURE=0
# Sign a user out after this many idle minutes (0 = off)
SESSION_IDLE_MINUTES=30
# Browser origins allowed to call the API cross-origin (comma separated). Empty = the local dev origins only.
CORS_ORIGINS=
# 1 when a trusted reverse proxy sets X-Forwarded-For (so login throttling sees the real client IP)
TRUST_PROXY=0

# ---- Demo behaviour and tuning (all optional; defaults shown)
# docker compose also reads DATASET, MFA and TWO_STORES from your shell.
# DATASET=large adds a generated six-month history (about 5,000 fills)
DATASET=demo
# 1 = require a 6-digit code (delivered to the sandbox outbox) after the password
MFA=0
# 0 = run one store instead of two
TWO_STORES=1
# 0 = do not poll openFDA every 2 hours
NIGHT_WATCH=1
# Shortest remaining shelf life accepted at receiving, in months
MIN_EXPIRY_MONTHS=6
# Days past due before a refill counts as overdue (0 to 60)
REFILL_GRACE_DAYS=7
# Delay of the sandbox SMS delivery receipts, in milliseconds
SANDBOX_DELAY_MS=1500
# 1 = skip openFDA and shortage-feed network calls (used by the timing evidence)
OFFLINE=0
# Vite dev server only: where it proxies /api. Set with CORS_ORIGINS if the web app is not on port 5173.
API_URL=http://127.0.0.1:4000

# ---- Integration placeholders (NOT WIRED). See docs/INTEGRATION_PLACEHOLDERS.md.
# A real deployment would need these. Chimera Rx never reads them: every connection below uses its sandbox
# stand-in, and nothing reaches a real person (pharmacy-safety rule 2). Leave them commented out.
# SMS (carrier or CPaaS API). Sandbox today: outbox.
# PLACEHOLDER_SMS_API_URL=
# PLACEHOLDER_SMS_API_KEY=
# PLACEHOLDER_SMS_FROM_NUMBER=
# Email (transactional email API). Sandbox today: outbox.
# PLACEHOLDER_EMAIL_API_URL=
# PLACEHOLDER_EMAIL_API_KEY=
# PLACEHOLDER_EMAIL_FROM=
# Outbound voice calls (telephony API; audio from VOICE_PROVIDER, e.g. local Kokoro). Sandbox today: rendered, never dialled.
# PLACEHOLDER_VOICE_CALL_API_URL=
# PLACEHOLDER_VOICE_CALL_API_KEY=
# PLACEHOLDER_VOICE_CALLER_ID=
# Wholesaler EDI (856/810) and EPCIS feed. Sandbox today: seeded deliveries, EPCIS dry-run import.
# PLACEHOLDER_WHOLESALER_EDI_URL=
# PLACEHOLDER_WHOLESALER_EPCIS_URL=
# PLACEHOLDER_WHOLESALER_CLIENT_ID=
# PLACEHOLDER_WHOLESALER_CLIENT_SECRET=
# PLACEHOLDER_GLN=
# DSCSA verification router. Sandbox today: fixture verifier.
# PLACEHOLDER_VRS_ROUTER_URL=
# PLACEHOLDER_VRS_CLIENT_CERT=
# PLACEHOLDER_VRS_CLIENT_KEY=
# E-prescribing network (NCPDP SCRIPT). Sandbox today: SCRIPT-shaped messages stored locally.
# PLACEHOLDER_ERX_NETWORK_URL=
# PLACEHOLDER_ERX_PHARMACY_NCPDP_ID=
# PLACEHOLDER_ERX_CLIENT_CERT=
# Pharmacy management / dispensing system. Sandbox today: Chimera Rx is its own ledger.
# PLACEHOLDER_PMS_API_URL=
# PLACEHOLDER_PMS_CLIENT_ID=
# PLACEHOLDER_PMS_CLIENT_SECRET=
# EHR via FHIR (outbound). Sandbox today: inbound FHIR R4 read surface only.
# PLACEHOLDER_EHR_FHIR_BASE_URL=
# PLACEHOLDER_EHR_CLIENT_ID=
# PLACEHOLDER_EHR_PRIVATE_KEY=
# Payer claims switch. Sandbox today: none ("Paid" is a label).
# PLACEHOLDER_PAYER_SWITCH_URL=
# PLACEHOLDER_PAYER_BIN=
# PLACEHOLDER_PAYER_PCN=
# PLACEHOLDER_PAYER_CLIENT_CERT=
# Secrets manager. Sandbox today: .env.
# PLACEHOLDER_SECRETS_MANAGER_URL=
# PLACEHOLDER_SECRETS_PATH=
# KMS for the data key. Sandbox today: KEY_PROVIDER=env or file (kms is a placeholder that refuses to start).
# PLACEHOLDER_KMS_KEY_ID=
# PLACEHOLDER_KMS_REGION=
# Identity provider / SSO (OIDC or SAML). Sandbox today: email + password, optional MFA=1.
# PLACEHOLDER_OIDC_ISSUER_URL=
# PLACEHOLDER_OIDC_CLIENT_ID=
# PLACEHOLDER_OIDC_CLIENT_SECRET=
