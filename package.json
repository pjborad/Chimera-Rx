{
  "name": "chimera-rx",
  "version": "0.1.0",
  "private": true,
  "description": "Pharmacy lot ledger that stitches barcodes, faxes, openFDA, an LLM, FHIR and MCP into one recall-to-patient pipeline. Synthetic data only. Kiroween 2026, Frankenstein.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:api": "pnpm --filter @chimera-rx/api run dev",
    "dev:web": "pnpm --filter @chimera-rx/web run dev",
    "setup": "pnpm --filter @chimera-rx/web run ocr:assets && pnpm --filter @chimera-rx/api run fax",
    "test": "vitest run",
    "typecheck": "pnpm -r --no-bail run typecheck",
    "build:web": "pnpm --filter @chimera-rx/web run build",
    "build:browser": "pnpm --filter @chimera-rx/browser run build",
    "preview:browser": "pnpm --filter @chimera-rx/browser run preview",
    "e2e:browser": "node scripts/e2e/browser-app.mjs",
    "e2e": "node scripts/e2e/run.mjs",
    "demo:record:submission": ".venv-voice/bin/python scripts/demo/make-voice.py full --speed 1.1 && node scripts/demo/record-submission.mjs",
    "evidence": "pnpm --filter @chimera-rx/api run evidence:accuracy && pnpm --filter @chimera-rx/api run evidence:timing",
    "fixtures:refresh": "bash scripts/refresh-fixtures.sh",
    "hooks:install": "bash scripts/install-hooks.sh"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "fast-check": "4.10.2",
    "playwright": "1.65.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
